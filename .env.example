# Structify AI Environment Configuration

# Local LLM Configuration

MODEL_PATH=models/qwen2.5-3b-instruct.gguf

# SQLite Database

DATABASE_PATH=structify.db

# Upload Directory

UPLOAD_FOLDER=uploads/

# Output Directory

OUTPUT_FOLDER=outputs/

# Cache Directory

CACHE_FOLDER=cache/

# OCR Language

OCR_LANGUAGE=en

# Application Settings

APP_NAME=Structify AI
APP_MODE=offline
LOG_LEVEL=INFO

# Maximum Upload Size (MB)

MAX_UPLOAD_SIZE=50
